# URBAIN V — configuration Apache (hébergement web OVH)

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

AddType image/webp .webp
AddType image/svg+xml .svg
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirection vers https://urbain-v.fr (sans www).
  # À ACTIVER uniquement quand le certificat SSL Let's Encrypt est actif sur urbain-v.fr
  # (Hébergement OVH > Multisite > SSL) : retirer le # des trois lignes ci-dessous.
  # RewriteCond %{SERVER_PORT} 80 [OR]
  # RewriteCond %{HTTP_HOST} ^www\. [NC]
  # RewriteRule ^(.*)$ https://urbain-v.fr/$1 [R=301,L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Fichiers internes au dépôt, non publiés
<FilesMatch "^(README\.md|CLAUDE\.md)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/(\.git|tools)(/|$)
